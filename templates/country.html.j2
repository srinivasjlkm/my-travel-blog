<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ country.name }} — My Travel Diaries</title>
<meta name="description" content="{{ country.tagline }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,500&family=Public+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="../assets/css/style.css">
</head>
<body>

<nav class="site-nav">
  <div class="wrap">
    <a href="../index.html" class="brand"><span class="brand-mark">✦</span> My Travel Diaries</a>
    <div class="nav-links">
      <a href="../index.html">Home</a>
      <a href="../index.html#stamps">Countries</a>
      <a href="../about.html">About</a>
      <a href="../plan.html">Plan a Trip</a>
      <a href="https://www.instagram.com/srinivasjlkm" target="_blank" rel="noopener" class="nav-insta">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor"/></svg>
        Instagram
      </a>
    </div>
    <button class="nav-toggle" aria-label="Menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>
  </div>
</nav>

<header class="country-hero">
  {% if country.hero_photo %}
  <img src="{{ country.hero_photo }}" alt="{{ country.name }} landscape">
  {% else %}
  <img src="https://picsum.photos/seed/{{ country.hero_seed }}/1600/1000" alt="{{ country.name }} landscape">
  {% endif %}
  <div class="country-hero-content wrap">
    <div class="eyebrow">Chapter · {{ country.stamp_bottom }} · Since {{ country.since }}</div>
    <h1>{{ country.name }}</h1>
    <p>{{ country.tagline }}</p>
  </div>
</header>

<nav class="country-nav">
  <div class="wrap" style="display:flex;">
    <a href="#story">Story</a>
    <a href="#itinerary">Itinerary</a>
    <a href="#gallery">Gallery</a>
    <a href="#logistics">The Logistics</a>
    {% if country.video %}<a href="#video">Video</a>{% endif %}
  </div>
</nav>

<section class="section" id="story">
  <div class="wrap">
    <div class="section-title reveal"><span class="idx">01</span><h2>The Story</h2></div>
    <p style="max-width:70ch;color:var(--text-ink-dim);font-size:17px;" class="reveal">{{ country.intro }}</p>

    <div class="route-strip reveal" style="margin-top:34px;">
      {% for place in country.places %}
        <a href="#stop-{{ loop.index }}" class="route-dot" data-stop-target="stop-{{ loop.index }}">{{ place.short }}</a>
        {% if not loop.last %}<span class="route-line"></span>{% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="section" id="itinerary" style="padding-top:0;">
  <div class="wrap">
    <div class="section-title reveal"><span class="idx">02</span><h2>Where I Went</h2></div>
    <div class="itinerary reveal">
      {% for place in country.places %}
      <div class="stop" id="stop-{{ loop.index }}">
        <div class="stop-head">
          <div class="stop-left">
            <h3>{{ place.name }}</h3>
          </div>
          <div style="display:flex;align-items:center;gap:18px;">
            <span class="stop-days">{{ place.days }}{% if place.when %} · {{ place.when }}{% endif %}</span>
            <svg class="stop-chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 5v14M5 12h14"/></svg>
          </div>
        </div>
        <div class="stop-panel">
          <div class="stop-panel-inner">
            {% if place.getting_there %}<p class="getting-there">→ {{ place.getting_there }}</p>{% endif %}
            <p>{{ place.note }}</p>
            <div class="stop-tags">
              {% for tag in place.tags %}<span class="tag">{{ tag }}</span>{% endfor %}
            </div>
            {% if place.highlights %}
              {% for h in place.highlights %}
              <figure class="place-hero">
                <img src="{{ h.img }}" alt="{{ h.caption }}" loading="lazy">
                {% if h.caption %}<figcaption>{{ h.caption }}</figcaption>{% endif %}
              </figure>
              {% if h.note %}<p class="highlight-note">{{ h.note }}</p>{% endif %}
              {% endfor %}
            {% endif %}
            <div class="gallery place-gallery" data-folder="assets/img/{{ country.slug }}/{{ place.slug }}/"></div>

            {% if place.sub_places %}
            <div class="sub-places">
              {% for sub in place.sub_places %}
              <div class="sub-place">
                <div class="sub-place-head">
                  <h4>{{ sub.name }}</h4>
                  <span class="sub-place-days">{{ sub.days }}{% if sub.when %} · {{ sub.when }}{% endif %}</span>
                </div>
                {% if sub.getting_there %}<p class="getting-there">→ {{ sub.getting_there }}</p>{% endif %}
                <p>{{ sub.note }}</p>
                <div class="stop-tags">
                  {% for tag in sub.tags %}<span class="tag">{{ tag }}</span>{% endfor %}
                </div>
                <div class="gallery place-gallery" data-folder="assets/img/{{ country.slug }}/{{ place.slug }}/{{ sub.slug }}/"></div>
              </div>
              {% endfor %}
            </div>
            {% endif %}
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section" id="gallery">
  <div class="wrap">
    <div class="section-title reveal"><span class="idx">03</span><h2>Through the Lens</h2></div>
    <div class="gallery reveal" data-country="{{ country.slug }}" data-fallback-count="{{ fallback_count }}">
      <p class="gallery-loading">Loading photos…</p>
    </div>
    <p class="video-note" style="margin-top:18px;">This gallery pulls live from the <code>assets/img/{{ country.slug }}/</code> folder in the repo — drop any photo in there and it appears here automatically, no code editing needed. Until real photos are added, placeholders fill the space.</p>
  </div>
</section>

<section class="section" id="logistics">
  <div class="wrap">
    <div class="section-title reveal"><span class="idx">{{ '04' if country.video else '04' }}</span><h2>The Logistics</h2></div>
    <div class="logistics-card reveal">
      <div class="lc-main">
        <h3>How I Got There & Around</h3>
        <div class="logistics-row"><span class="lr-label">Flights</span><span class="lr-val">{{ country.logistics.flights }}</span></div>
        <div class="logistics-row"><span class="lr-label">Stay</span><span class="lr-val">{{ country.logistics.stay }}</span></div>
        <div class="logistics-row"><span class="lr-label">Getting around</span><span class="lr-val">{{ country.logistics.transport }}</span></div>
        <div class="logistics-row"><span class="lr-label">Daily budget</span><span class="lr-val">{{ country.logistics.budget }}</span></div>
        <div class="logistics-row"><span class="lr-label">Best time to go</span><span class="lr-val">{{ country.logistics.best_time }}</span></div>
      </div>
      <div class="lc-side"></div>
      <div class="lc-tickets">
        <h3 style="margin-bottom:6px;">Booked & Used</h3>
        <p style="font-family:var(--font-mono);font-size:11.5px;color:var(--text-paper-dim);margin-top:0;">Affiliate-ready — swap "#" links for your own booking links</p>
        {% for t in country.logistics.tickets %}
        <div class="ticket">
          <div class="tk-type">{{ t.type }}</div>
          <div class="tk-name">{{ t.name }}</div>
          <div class="tk-note">{{ t.note }}</div>
          <a href="{{ t.link }}">View booking →</a>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% if country.video %}
<section class="section" id="video" style="padding-top:0;">
  <div class="wrap">
    <div class="section-title reveal"><span class="idx">05</span><h2>{{ country.name }} on Video</h2></div>
    <div class="video-frame reveal">
      <iframe src="https://www.youtube.com/embed/dQw4w9WgXcQ" title="{{ country.name }} travel video" allowfullscreen loading="lazy"></iframe>
    </div>
    <p class="video-note">Replace the embed ID above with your own YouTube video ID for {{ country.name }}. Only travel clips are embedded here — your variety channel stays separate.</p>
  </div>
</section>
{% endif %}

<section class="section" style="padding-top:0;">
  <div class="wrap" style="display:flex;justify-content:space-between;border-top:1px solid var(--ink-line);padding-top:40px;flex-wrap:wrap;gap:20px;">
    {% if prev_country %}
    <a href="{{ prev_country.slug }}.html" class="btn btn-ghost">← {{ prev_country.name }}</a>
    {% else %}<span></span>{% endif %}
    {% if next_country %}
    <a href="{{ next_country.slug }}.html" class="btn btn-primary">{{ next_country.name }} →</a>
    {% else %}<a href="../countries/more.html" class="btn btn-primary">More Countries →</a>{% endif %}
  </div>
</section>

<footer class="site-footer">
  <div class="wrap footer-grid">
    <span class="footer-note">My Travel Diaries — a personal travel journal. Photos & stories from the road.</span>
    <a href="https://www.instagram.com/srinivasjlkm" target="_blank" rel="noopener" class="footer-insta">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor"/></svg>
      @srinivasjlkm
    </a>
  </div>
</footer>

<script src="../assets/js/main.js"></script>
</body>
</html>
